# Copy to .env and fill in required values.

# --- API server ---
PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/portsai

# Session Secret (Required in production, min 16 characters)
SESSION_SECRET=

# Origin allowed to make credentialed requests to the API
CLIENT_ORIGIN=http://localhost:3000

# --- Next.js frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TJ72G9HQD5

# --- Vision model (optional) ---
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
