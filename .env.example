# Copy to .env and fill in.

# --- API server ---
PORT=4000
NODE_ENV=development

# Replace with the production MongoDB connection string when available.
MONGODB_URI=mongodb://127.0.0.1:27017/portsai

# REQUIRED in production. Must be a long random string (>= 16 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed to make credentialed requests to the API.
CLIENT_ORIGIN=http://localhost:3000

# --- Next.js frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Vision model (optional) ---
# Without a key, image analysis is skipped and matching uses the description only.
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
